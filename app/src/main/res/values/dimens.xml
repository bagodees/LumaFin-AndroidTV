<resources>
    <dimen name="overscan_horizontal">27dp</dimen>
    <dimen name="overscan_vertical">48dp</dimen>

    <!-- Compact playback controls leave room for the end time on the button row. Buttons are drawn
         as rounded LumaFin surfaces, so widths stay below the center-to-center spacing. -->
    <dimen name="lb_control_button_diameter">48dp</dimen>
    <dimen name="lb_control_button_height">44dp</dimen>
    <dimen name="lb_control_button_secondary_diameter">44dp</dimen>
    <dimen name="lb_control_button_secondary_height">40dp</dimen>
    <dimen name="lb_control_icon_width">22dp</dimen>
    <dimen name="lb_control_icon_height">22dp</dimen>
    <dimen name="lb_playback_controls_child_margin_default">32dp</dimen>
    <dimen name="lb_playback_controls_child_margin_bigger">40dp</dimen>
    <dimen name="lb_playback_controls_child_margin_biggest">56dp</dimen>
    <!-- 28dp total below the focus label: keep a TV-safe inset without the
         previous stacked 28dp grid + 20dp row padding. -->
    <dimen name="lb_playback_controls_padding_bottom">16dp</dimen>
    <dimen name="lumafin_playback_label_clearance">12dp</dimen>

    <fraction name="card_scale_default">100%</fraction>
    <!-- Keep focus clear without making the selected card dominate its row. -->
    <fraction name="card_scale_focus">108%</fraction>

    <!-- Set leanback card scale values -->
    <fraction name="lb_focus_zoom_factor_small">@fraction/card_scale_focus</fraction>
    <fraction name="lb_focus_zoom_factor_xsmall">@fraction/card_scale_focus</fraction>
    <fraction name="lb_focus_zoom_factor_medium">@fraction/card_scale_focus</fraction>
    <fraction name="lb_focus_zoom_factor_large">@fraction/card_scale_focus</fraction>
</resources>
