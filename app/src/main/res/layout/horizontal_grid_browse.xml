<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/details_readability_gradient"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:id="@+id/rowsFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/libraryFooter"
        android:layout_below="@+id/infoRow"
        android:layout_alignParentStart="true"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="0dp" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="50dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:layout_toStartOf="@+id/npBug"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textSize="28sp"
        android:textColor="@color/lumafin_text" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="24sp"
        android:layout_below="@+id/title"
        android:layout_alignStart="@+id/title"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:id="@+id/infoRow"
        android:layout_toStartOf="@+id/toolBar"/>

    <LinearLayout
        android:id="@+id/toolBar"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/title"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="40dp"
        android:alpha="1"
        android:dividerPadding="4dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:showDividers="middle" />

    <LinearLayout
        android:id="@+id/libraryFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignStart="@+id/title"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="13sp"
        android:layout_marginEnd="60sp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="16dp"
            android:textSize="12sp"
            android:alpha=".85"
            android:textColor="@color/lumafin_text"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="0 | 0"
            android:textAlignment="viewEnd"
            android:textSize="18sp"
            android:textColor="@color/lumafin_text"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <org.jellyfin.androidtv.ui.ClockUserView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/clock"
        android:layout_alignTop="@+id/title"
        android:layout_marginEnd="40sp"
        android:layout_marginStart="8sp"
        android:layout_alignParentEnd="true" />

    <org.jellyfin.androidtv.ui.NowPlayingView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/npBug"
        android:layout_toStartOf="@+id/clock"
        android:layout_alignTop="@+id/clock"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="15dp" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</RelativeLayout>
