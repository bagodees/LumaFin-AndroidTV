<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides androidx.leanback's primary control button with the LumaFin rounded style. Ids must be kept. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/button"
        style="?attr/playbackControlsButtonStyle"
        android:layout_width="@dimen/lb_control_button_diameter"
        android:layout_height="@dimen/lb_control_button_height"
        android:scaleType="fitXY"
        android:defaultFocusHighlightEnabled="false"
        android:src="@drawable/lumafin_player_button" />

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/lb_control_icon_width"
        android:layout_height="@dimen/lb_control_icon_height"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        style="?attr/playbackControlButtonLabelStyle" />
</FrameLayout>
